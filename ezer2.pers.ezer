#pragma library,test

# Systém Ezer2 - panel osobního nastavení
# (c) 2010-2025 Martin Šmídek <martin@smidek.eu>

var the_user: number
var last_item: ezer

use rp: form right [12,4,,]
use ch: form _chng [12,70,,]
use msg: form _msg [12,70,,]

func onfirstfocus () {
  echo('ONFIRSTFOCUS'); the_user= sys('user','id_user'); m.g.i.click(); 
}

func onstart() {
  echo('ONSTART'); the_user= sys('user','id_user');
  if (has_skill('a')) rp.id_user.key(the_user); 
}

menu m {type:'left',
  menu g { title:"Přehled osobních nastavení", type:'group'
    item i { title:"osobní záznam"              ,par:{typ:'oso'} }
    item   { title:"m: zobrazení funkce sys"    ,par:{typ:'sys'}, skill:'m' }
    item   { title:"m: zobrazení Ezer.options"  ,par:{typ:'opt'}, skill:'m' }
    item   { title:"m: zobrazení _SESSION"      ,par:{typ:'ses'}, skill:'m' }
    item   { title:"m: zobrazení USER"          ,par:{typ:'use'}, skill:'m' }
    item   { title:"m: zobrazení EZER"          ,par:{typ:'eze'}, skill:'m' }
    func onclick(i:ezer) {
      last_item= i;
      rp.header(i);
      ch.display(0); msg.display(1);
      switch (i.par.typ) {
        case 'oso': msg.txt= php.sys_user_record(the_user); break;
        case 'sys': msg.txt= debug(sys()); break;
        case 'opt': msg.txt= debug(javascript('Ezer.options')); break;
        case 'ses': msg.txt= php.sys_session(); break;
        case 'use': msg.txt= php.sys_user(); break;
        case 'eze': msg.txt= php.sys_ezer(); break;
      }
    }
  }
  menu {title:"Změna osobního nastavení", type:'group', _sys:'jm'
    item { title:"změna emailové adresy"      ,par:{typ:'opt',fld:'email'} }
    item { title:"změna emailové patičky"     ,par:{typ:'txt',fld:'email_foot'} }
    item { title:"změna SMTP serveru"         ,par:{typ:'opt',fld:'smtp'} }
    item { title:"změna textu 'vyřizuje'"     ,par:{typ:'opt',fld:'vyrizuje'} }
    item { title:"změna textu 'potvrzuje'"    ,par:{typ:'opt',fld:'potvrzuje'} }
    item { title:"m: změna options 'to_trace'",par:{typ:'oop',fld:'to_trace'}, skill:'m' }
    item { title:"změna stylu zobrazení"      ,par:{typ:'opt',fld:'css'} }
    item { title:"změna hesla"                ,par:{typ:'pas'} }
    item { title:"změna přihlašovacího jména" ,par:{typ:'fld',fld:'username'} }
    item { title:"m: změna položky 'state'"   ,par:{typ:'fld',fld:'state'}, skill:'m' }
  }
  func onclick (i:ezer) {
    last_item= i;
    ch.display(1); msg.display(0);
    rp.header(i); 
    ch._load(i,i.par);
  }
}

# -------------------------------------------------------------------------------------------------- _msg
# formulář pro zprávu
form _msg [,,700,500] {
  label txt [0,0,690,500]
}
# -------------------------------------------------------------------------------------------------- _chng
# formulář pro změnu jedné položky
form _chng [,,700,120] { style:'z-index:2'
  var the_itm: ezer
  var the_par: object
  func onchanged() { _form_state('bc','bn') }
  field ops [110,0,200,]  { tag:'p', title:'stará hodnota:', format:'pnt' }
  field old [110,0,200,]  { tag:'o', title:'stará hodnota:', format:'o' }
  field new [110,30,200,] { tag:'o', title:'nová hodnota:', format:'' }
  field nps [110,30,200,] { tag:'p', title:'nová hodnota:', format:'np' }
  field rep [390,30,200,] { tag:'p', title:'opakovaně:', format:'np' }
  label     [0,0,157,15]  { tag:'f', title:'stará patička:', format:'r' }
  label fo1 [170,0,400,100]  { tag:'f', format:'o' }
  label     [0,141,100,14]  { tag:'f', title:'nová patička:', format:'r' }
  edit  fo2 [110,142,500,183] { tag:'f', type:'html' }
# procedury
  func _form_state(on,off) { form.enable(1,on); form.enable(0,off); }
  func _form_show(on,off) { form.display(1,on); form.display(0,off); }
  func _init() { _form_state('bn','bc'); new.init() }
  func _load(i:ezer,par:object) {
    the_itm= i; _init();
    the_par= par;
    switch (the_par.typ) {
      case 'fld': _form_show('o','p|f'); old= php.sys_user_get(the_user,the_par.typ,the_par.fld); break; 
      case 'opt': _form_show('o','p|f'); old= php.sys_user_get(the_user,the_par.typ,the_par.fld); break;
      case 'oop': _form_show('o','p|f'); old= php.sys_user_get(the_user,the_par.typ,the_par.fld); break;
      case 'txt': _form_show('f','p|o'); fo1= php.sys_user_get(the_user,the_par.typ,the_par.fld); fo2= fo1; break;
      case 'pas': _form_show('p','o|f'); break;
    }
  }
  # tlačítka
  func _init() { _form_state('bn','bc'); form.init() }
  button [20,70,,]  { tag:'bc', title:'Uložit změnu',
    help:'zapsat novou hodnotu do osobního nastavení'
    func onclick () {
      var t:text, f:text
      t= the_par.typ; f= the_par.fld;
      switch (t) {
        case 'fld': 
          _form_show('o','p|f'); rp.append(php.sys_user_change(the_user,t,f,new)); new.plain(); break;
        case 'opt':
          _form_show('o','p|f'); rp.append(php.sys_user_change(the_user,t,f,new)); new.plain(); break;
        case 'oop': 
          _form_show('o','p|f'); rp.append(php.sys_user_change(the_user,t,f,new)); new.plain(); break;
        case 'txt':
          _form_show('f','p|o'); rp.append(php.sys_user_change(the_user,t,f,fo2)); fo2.plain(); break;
        case 'pas':
          _form_show('p','o|f'); rp.append(php.sys_user_change(the_user,t,'',nps,ops,rep)); _init(); break;
      }
    } 
  }
  button [110,70,,] { tag:'bc', title:' Zpět ',
    help:'ponechat starou hodnotu osobního nastavení'
    func onclick () { the_itm.click() } }
}
# -------------------------------------------------------------------------------------------- right
# formulář pro levostranné menu s postupným zápisem
form right [,,*,50] {
  label head [0,0,*,50]  { title:' ' }
  select id_user [-20,5,100,20] { type:'map', options:user.surname, format:'xt', skill:'a|a'
    help:'výběr uživatele'
    func onchanged () {
      echo('vybráno:',id_user,',',id_user.key());
      the_user= id_user.key();
      last_item.click();
    } 
  }
  label note [0,170,*,550] { title:' ' }
  func header(i:ezer) { var i_owner:ezer
    clear(); i_owner= i.owner();
    head= replace_fa(`<div class='karta'>${i_owner.title} - ${i.title}</div>`);
    note= '';
  }
  func fill(x,y) {
    if (x) head= `<div class='karta'>${replace_fa(x)}</div>`;
    if (y) note= y
  }
  func append(y) {
    if (y) note= conc(note,y)
  }
}

map user:  table _user { where:'1', order:'surname', key_id:'id_user', db:'ezer_system'}

table _user { key_id:'id_user', db:'ezer_system'
  number id_user
  text deleted,
  text abbr,
  text skills,
  text options { help:'privátní nastavení|ve formátu JSON' }
  text username,
  text password,
  text state,
  text forename,
  text surname,
  text login,
  text history,
  text sess_id,
  text sess_time,
  text sess_data,
  number zmena_kdo,
  date zmena_kdy {  },
}

